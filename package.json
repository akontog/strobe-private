{
  "name": "strobe-unified-server",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "main": "server/server.js",
  "scripts": {
    "start": "npm run start --workspace server",
    "dev": "npm run dev --workspace server",
    "start:server": "npm run start --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start:client": "npm run dev --workspace client",
    "build:client": "npm run build --workspace client",
    "build": "npm run build --workspace client",
    "clean:labs": "node -e \"require('fs').rmSync('client/dist/labs',{ recursive: true, force: true })\"",
    "build:neural-lab": "npm run build:neural-lab:teacher && npm run build:neural-lab:student",
    "build:neural-lab:teacher": "esbuild client/src/labs/neural-lab/teacher.jsx --bundle --format=esm --outfile=client/dist/labs/neural-lab/teacher.bundle.js --loader:.jsx=jsx --loader:.css=css",
    "build:neural-lab:student": "esbuild client/src/labs/neural-lab/student.jsx --bundle --format=esm --outfile=client/dist/labs/neural-lab/student.bundle.js --loader:.jsx=jsx --loader:.css=css",
    "build:buffon-needle": "npm run build:buffon-needle:teacher && npm run build:buffon-needle:student",
    "build:buffon-needle:teacher": "esbuild client/src/labs/buffon-needle/teacher.jsx --bundle --format=esm --outfile=client/dist/labs/buffon-needle/teacher.bundle.js --loader:.jsx=jsx --loader:.css=css",
    "build:buffon-needle:student": "esbuild client/src/labs/buffon-needle/student.jsx --bundle --format=esm --outfile=client/dist/labs/buffon-needle/student.bundle.js --loader:.jsx=jsx --loader:.css=css",
    "build:geometry-live": "esbuild client/src/labs/geometry-live/index.jsx --bundle --format=esm --outfile=client/dist/labs/geometry-live/geometry-shell.bundle.js --loader:.jsx=jsx",
    "build:all": "npm run build:client"
  },
  "dependencies": {
    "express": "^5.2.1",
    "i18next": "^26.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.12",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
