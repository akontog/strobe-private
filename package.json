{
  "name": "strobe-unified-server",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "main": "server/server.js",
  "scripts": {
    "start": "npm run start --workspace server",
    "dev": "npm run dev --workspace server",
    "start:server": "npm run start --workspace server",
    "start:client": "npm run dev --workspace client",
    "build:client": "npm run build --workspace client",
    "build:neural-lab": "npm run build:neural-lab:teacher && npm run build:neural-lab:student",
    "build:neural-lab:teacher": "esbuild apps/neural-lab/teacher.jsx --bundle --format=esm --outfile=apps/neural-lab/teacher.bundle.js --loader:.jsx=jsx --loader:.css=css",
    "build:neural-lab:student": "esbuild apps/neural-lab/student.jsx --bundle --format=esm --outfile=apps/neural-lab/student.bundle.js --loader:.jsx=jsx --loader:.css=css",
    "build:buffon-needle": "npm run build:buffon-needle:teacher && npm run build:buffon-needle:student",
    "build:buffon-needle:teacher": "esbuild apps/buffon-needle/teacher.jsx --bundle --format=esm --outfile=apps/buffon-needle/teacher.bundle.js --loader:.jsx=jsx --loader:.css=css",
    "build:buffon-needle:student": "esbuild apps/buffon-needle/student.jsx --bundle --format=esm --outfile=apps/buffon-needle/student.bundle.js --loader:.jsx=jsx --loader:.css=css",
    "build:linear": "npm run build --prefix tools/linear-seperation"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
