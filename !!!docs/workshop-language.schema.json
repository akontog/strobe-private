{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strobe.local/schemas/workshop-language.schema.json",
  "title": "Strobe Activity Language v1.0",
  "type": "object",
  "required": ["schemaVersion", "documentType", "language", "resources"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "documentType": { "enum": ["activity", "sequence", "workshop"] },
    "language": { "type": "string", "minLength": 2 },
    "metadata": { "$ref": "#/$defs/metadata" },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    },
    "activity": { "$ref": "#/$defs/activity" },
    "sequence": { "$ref": "#/$defs/sequence" },
    "workshop": { "$ref": "#/$defs/workshop" },
    "activities": {
      "type": "array",
      "items": { "$ref": "#/$defs/activity" }
    },
    "sequences": {
      "type": "array",
      "items": { "$ref": "#/$defs/sequence" }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "author": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "required": ["id", "type", "config"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "input-grid",
            "options-grid",
            "placement-board",
            "grouping-drag-drop",
            "venn-board",
            "number-line",
            "algebra-tiles",
            "collaborative-geogebra",
            "vision-board",
            "activity-content",
            "activity-data",
            "icon",
            "equation",
            "plot-widget",
            "equation-answer",
            "identity-expression",
            "identity-polynomial"
          ]
        },
        "region": { "enum": ["left", "center", "right", "top", "bottom"] },
        "config": {
          "type": "object",
          "required": ["settings"],
          "properties": {
            "settings": { "type": "object" },
            "data": {},
            "presentation": { "type": "object" },
            "display": { "type": "object" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": ["id", "code", "title", "mode", "usesResources"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string" },
        "notes": { "type": "string" },
        "mode": { "type": "string", "minLength": 1 },
        "usesResources": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "workshop": {
      "type": "object",
      "required": ["id", "title", "presentation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "presentation": { "type": "object" }
      },
      "additionalProperties": false
    },
    "sequence": {
      "type": "object",
      "required": ["id", "title", "activityIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "activityIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "documentType": { "const": "activity" } } },
      "then": { "required": ["activity"] }
    },
    {
      "if": { "properties": { "documentType": { "const": "sequence" } } },
      "then": { "required": ["sequence", "activities"] }
    },
    {
      "if": { "properties": { "documentType": { "const": "workshop" } } },
      "then": {
        "required": ["workshop"],
        "anyOf": [
          { "required": ["activities"], "properties": { "activities": { "minItems": 1 } } },
          { "required": ["sequences"], "properties": { "sequences": { "minItems": 1 } } }
        ]
      }
    }
  ],
  "additionalProperties": false
}
